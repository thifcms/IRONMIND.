rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Autoriza se: (a) o dono é literalmente o dono do documento (contas
      // novas, onde o ID do doc == uid do Firebase Auth), (b) o campo
      // authUid do documento aponta pro uid autenticado (contas antigas já
      // migradas), OU (c) é uma conta com Firebase Auth criado mas ainda
      // sem vínculo (authUid vazio) e o e-mail do token bate com o do
      // documento — permite completar o vínculo sozinho, sem reabrir as
      // regras manualmente. Como o e-mail do token só existe depois de uma
      // autenticação real (senha comprovada pelo Firebase), isso é seguro.
      allow read, update: if request.auth != null &&
        (request.auth.uid == userId ||
         request.auth.uid == resource.data.authUid ||
         (resource.data.authUid == null && resource.data.email == request.auth.token.email));

      allow delete: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == resource.data.authUid);

      allow create: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == request.resource.data.authUid);

      match /chats/{messageId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid;
      }

      match /webauthnCredentials/{credentialId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid;
      }
    }

    // Desafios temporários do login biométrico (WebAuthn), com expiração
    // de 5 minutos controlada pelo próprio servidor na leitura. Sem
    // Service Account (bloqueada pela política da organização), o
    // servidor só consegue gravar/ler aqui via API REST com a chave
    // pública -- por isso a regra é aberta. Isso é seguro porque: (1) o
    // conteúdo é só um "desafio" criptográfico aleatório, inútil sem a
    // assinatura biométrica correspondente; (2) o ID do documento
    // (flowId) é um UUID aleatório, inviável de adivinhar; (3) expira em
    // minutos. Mesmas propriedades de segurança que o Map em memória que
    // isso substituiu.
    match /webauthnChallenges/{flowId} {
      allow read, write, delete: if true;
    }
  }
}
