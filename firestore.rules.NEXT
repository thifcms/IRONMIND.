rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Autoriza se: (a) o dono é literalmente o dono do documento (contas
      // novas, onde o ID do doc == uid do Firebase Auth), OU (b) o campo
      // authUid do documento aponta pro uid autenticado (contas antigas
      // migradas, que mantêm o ID original do Firestore).
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == resource.data.authUid);

      allow create: if request.auth != null &&
        (request.auth.uid == userId || request.auth.uid == request.resource.data.authUid);

      match /chats/{messageId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/users/$(userId)).data.authUid == request.auth.uid;
      }
    }
  }
}
