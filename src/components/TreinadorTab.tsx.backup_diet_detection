import { useState, useRef, useEffect, Dispatch, SetStateAction } from 'react';
import { Send, Check, Loader2, Trash2, ShieldCheck, ShieldAlert, Cpu, X, Sparkles, Activity, Globe, Zap, AlertCircle, Copy } from 'lucide-react';
import { motion, AnimatePresence } from 'motion/react';
import ReactMarkdown from 'react-markdown';
import remarkGfm from 'remark-gfm';
import { ChatMessage, TrainingPlan, DietPlan } from '../types';
import { chatWithCoach, generateProposal, diagnoseNeuralLink, updateNeuralLinkUrl } from '../services/geminiService';
import { checkAIHealth } from '../services/aiManagerService';

interface TreinadorTabProps {
  history: ChatMessage[];
  setHistory: Dispatch<SetStateAction<ChatMessage[]>>;
  onAcceptTraining: (plan: TrainingPlan) => void;
  onAcceptDiet: (plan: DietPlan) => void;
  onClearChat?: () => void;
  userContext?: {
    profile: any;
    weight: number | null;
    measurements: any[];
  };
}

function NeuralLinkDiagnostic({ onClose, onStatusChange }: { onClose: () => void, onStatusChange?: (online: boolean) => void }) {
  const [diag, setDiag] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [editUrl, setEditUrl] = useState('');
  const [editApiKey, setEditApiKey] = useState('');
  const [isUpdating, setIsUpdating] = useState(false);

  useEffect(() => {
    runDiagnostic();
  }, []);

  const handleUpdateConfig = async () => {
    if (!editUrl && !editApiKey) return;
    setIsUpdating(true);
    const res = await updateNeuralLinkUrl(editUrl || undefined, editApiKey || undefined);
    if (res.success) {
      await runDiagnostic();
      setEditUrl('');
      setEditApiKey('');
    } else {
      alert(res.message || "Erro ao atualizar");
    }
    setIsUpdating(false);
  };

  const runDiagnostic = async () => {
    setLoading(true);
    const result = await diagnoseNeuralLink();
    setDiag(result);
    setLoading(false);
    if (onStatusChange) onStatusChange(!!result.online);
  };

  return (
    <motion.div 
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      className="absolute inset-x-4 top-16 z-50 bg-white dark:bg-[#1a1a1a] rounded-3xl p-6 shadow-2xl border border-slate-200 dark:border-slate-800"
    >
      <div className="flex justify-between items-start mb-6">
        <div className="flex items-center gap-3">
          <div className="p-2.5 bg-blue-50 dark:bg-blue-900/20 rounded-xl">
            <Zap className="w-5 h-5 text-blue-600" />
          </div>
          <div>
            <h3 className="text-[12px] font-black uppercase tracking-widest text-slate-900 dark:text-white">Diagnóstico de Link</h3>
            <p className="text-[10px] text-slate-500 font-bold uppercase tracking-tight">Agente Integrador em Ação</p>
          </div>
        </div>
        <button onClick={onClose} className="p-2 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-full transition-colors">
          <X className="w-4 h-4 text-slate-400" />
        </button>
      </div>

      {loading ? (
        <div className="flex flex-col items-center justify-center py-10 gap-4">
          <Loader2 className="w-8 h-8 animate-spin text-blue-600" />
          <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 animate-pulse">Sincronizando Frequências...</p>
        </div>
      ) : (
        <div className="space-y-4">
          <div className="grid grid-cols-2 gap-3">
            <div className="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-800">
              <span className="text-[8px] font-black uppercase tracking-widest text-slate-400 block mb-1">Status</span>
              <div className="flex items-center gap-3">
                <div className="relative flex items-center justify-center w-4 h-4">
                  <div className={`absolute inset-0 rounded-full blur-[6px] ${diag.online ? 'bg-emerald-400 animate-pulse opacity-100' : 'bg-rose-400 opacity-50'}`} />
                  <div className={`relative w-2.5 h-2.5 rounded-full z-10 ${diag.online ? 'bg-emerald-500 shadow-[0_0_15px_rgba(16,185,129,1)] scale-110' : 'bg-rose-500'}`} />
                  {diag.online && (
                    <div className="absolute inset-0 rounded-full animate-ping bg-emerald-500 opacity-40" />
                  )}
                </div>
                <span className={`text-[12px] font-black uppercase tracking-tighter ${diag.online ? 'text-emerald-600' : 'text-rose-600'}`}>
                  {diag.online ? 'Online' : 'Offline'}
                </span>
              </div>
            </div>
            <div className="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-800">
              <span className="text-[8px] font-black uppercase tracking-widest text-slate-400 block mb-1">Latência</span>
              <span className="text-[12px] font-black text-slate-900 dark:text-white uppercase tracking-tight">
                {diag.latency || 'N/A'}
              </span>
            </div>
          </div>

          <div className="p-4 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border border-slate-100 dark:border-slate-800 overflow-hidden space-y-3">
            <div>
              <div className="flex items-center gap-2 mb-2">
                <Globe className="w-3.5 h-3.5 text-slate-400" />
                <span className="text-[8px] font-black uppercase tracking-widest text-slate-400">URL do Cérebro Externo (API)</span>
              </div>
              
              <div className="flex gap-2">
                 <input 
                   type="text"
                   value={editUrl}
                   onChange={(e) => setEditUrl(e.target.value)}
                   placeholder="Ex: https://seu-app.run.app/api/chat"
                   className="flex-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-[10px] focus:outline-none focus:border-blue-500 transition-all font-mono"
                 />
              </div>
              <code className="mt-1.5 text-[9px] text-blue-600 dark:text-blue-400 font-mono break-all opacity-80 leading-relaxed block bg-white dark:bg-slate-800 p-2 rounded-lg">
                Link Atual: {diag?.target}
              </code>
            </div>

            <div>
              <div className="flex items-center gap-2 mb-2">
                <Zap className="w-3.5 h-3.5 text-slate-400" />
                <span className="text-[8px] font-black uppercase tracking-widest text-slate-400">Chave de Acesso (API Key / Token)</span>
              </div>
              
              <div className="flex gap-2">
                 <input 
                   type="text"
                   value={editApiKey}
                   onChange={(e) => setEditApiKey(e.target.value)}
                   placeholder="Ex: HUB_IRONMIND_..."
                   className="flex-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-[10px] focus:outline-none focus:border-blue-500 transition-all font-mono"
                 />
              </div>
              <code className="mt-1.5 text-[9px] text-blue-600 dark:text-blue-400 font-mono break-all opacity-80 leading-relaxed block bg-white dark:bg-slate-800 p-2 rounded-lg">
                Chave Ativa: {diag?.apiKey || "Nenhuma chave configurada"}
              </code>
            </div>

            <button 
              onClick={handleUpdateConfig}
              disabled={isUpdating || (!editUrl && !editApiKey)}
              className="w-full py-2 bg-blue-600 text-white rounded-lg text-[9px] font-black uppercase tracking-widest disabled:opacity-50 transition-all mt-1"
            >
              {isUpdating ? 'Salvando Configurações...' : 'Salvar Configurações'}
            </button>
          </div>

          {!diag.online && (
            <div className="p-4 bg-rose-50 dark:bg-rose-950/20 rounded-2xl border border-rose-100 dark:border-rose-900/50 flex gap-3">
              <AlertCircle className="w-5 h-5 text-rose-500 flex-shrink-0" />
              <div>
                <span className="text-[10px] font-black uppercase tracking-widest text-rose-600 mb-1 block">Correção Sugerida</span>
                <p className="text-[11px] text-rose-700 dark:text-rose-300 font-medium leading-relaxed">
                  {diag.suggestion}
                </p>
              </div>
            </div>
          )}

          <button 
            onClick={runDiagnostic}
            className="w-full py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] shadow-xl active:scale-95 transition-all mt-4"
          >
            Refazer Teste de Link
          </button>
        </div>
      )}
    </motion.div>
  );
}

export default function TreinadorTab({ history, setHistory, onAcceptTraining, onAcceptDiet, onClearChat, userContext }: TreinadorTabProps) {
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [loadingMessage, setLoadingMessage] = useState('Conectando ao Motor Neural... aguarde.');
  const [aiStatus, setAiStatus] = useState<{status: string, message: string} | null>(null);
  const [neuralLinkOnline, setNeuralLinkOnline] = useState<boolean | null>(null);
  const [showDiagnostic, setShowDiagnostic] = useState(false);
  const scrollRef = useRef<HTMLDivElement>(null);

  const [showQuotaInfo, setShowQuotaInfo] = useState(false);

  useEffect(() => {
    checkAIHealth().then(setAiStatus);
    diagnoseNeuralLink().then(res => setNeuralLinkOnline(!!res.online));

    const handleOnline = () => setNeuralLinkOnline(true);
    const handleOffline = () => setNeuralLinkOnline(false);

    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);

    // Initial check just in case
    if (!navigator.onLine) {
      setNeuralLinkOnline(false);
    }

    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [history]);

  const [pendingFallback, setPendingFallback] = useState<{message: string, context?: string, type?: 'chat' | 'training' | 'diet'} | null>(null);
  const [copiedIndex, setCopiedIndex] = useState<number | null>(null);

  const handleSend = async (overrideMessage?: string, forceFallback: boolean = false) => {
    const messageToSend = overrideMessage || input;
    if (!messageToSend.trim() || isLoading) return;

    if (!overrideMessage) {
      const userMessage: ChatMessage = { role: 'user', text: messageToSend };
      setHistory(prev => [...prev, userMessage]);
      setInput('');
    }
    
    setIsLoading(true);
    setPendingFallback(null);
    setLoadingMessage('Conectando ao Motor Neural... aguarde.');

    const maxAttempts = 12; // 12 * 10s = 120s total timeout
    let currentAttempt = 0;
    let response: ChatMessage | null = null;
    let lastError: any = null;

    while (currentAttempt < maxAttempts) {
      try {
        if (currentAttempt > 0) {
          setLoadingMessage(`Motor em Cold Start... Tentativa ${currentAttempt + 1} de ${maxAttempts} (Aguardando resposta)`);
        } else {
          setLoadingMessage('Conectando ao Motor Neural... aguarde.');
        }

        response = await chatWithCoach(history, messageToSend, userContext?.profile, userContext?.profile?.uid, forceFallback);
        // Se chegou aqui, deu certo
        break;
      } catch (error: any) {
        lastError = error;
        // Se for erro de timeout ou o código específico de cold start que adicionei no server
        const isOffline = error.code === 'PRIMARY_ENGINE_OFFLINE' || 
                         error.message === 'MOTOR_OFFLINE_COLD_START' || 
                         error.message.includes('503') ||
                         error.message.includes('Failed to fetch');

        if (isOffline && currentAttempt < maxAttempts - 1 && !forceFallback) {
          currentAttempt++;
          console.warn(`[FRONT_RETRY ${currentAttempt}/${maxAttempts}] Cold Start detectado. Aguardando 10s...`);
          await new Promise(r => setTimeout(r, 10000));
          continue;
        }
        throw error;
      }
    }

    if (!response) throw lastError || new Error("Falha final após múltiplas tentativas.");

    try {
      const text = response.text;
      const lowerText = text.toLowerCase();
      
      const isTrainingProposal = lowerText.includes('séries') || lowerText.includes('repetições') || lowerText.includes('exercício');
      const isDietProposal = lowerText.includes('calorias') || lowerText.includes('proteína') || lowerText.includes('carboidrato') || lowerText.includes('refeição');

      const cleanText = response.text.replace(/\[PROPOSTA_TREINO\]/gi, '').replace(/\[PROPOSTA_DIETA\]/gi, '').trim();
      let cleanResponse = { ...response, text: cleanText };

      setHistory(prev => [...prev, cleanResponse]);

      let hasProposal = false;

      // Try parsing JSON directly from the message text first
      const jsonMatch = cleanText.match(/\{[\s\S]*\}|\[[\s\S]*\]/);
      if (jsonMatch) {
        try {
          const parsed = JSON.parse(jsonMatch[0].replace(/```json/gi, '').replace(/```/g, '').trim());
          if (parsed && typeof parsed === 'object') {
            // Check for 'days' directly or nested inside 'trainingPlan'
            const trainingData = parsed.days ? parsed : (parsed.trainingPlan || parsed);
            
            if (trainingData.days && trainingData.days.length > 0) {
              // Looks like a TrainingPlan
              cleanResponse = {
                ...cleanResponse,
                text: cleanText.replace(jsonMatch[0], '').replace(/```json/gi, '').replace(/```/g, '').trim(),
                proposal: { type: 'training', data: trainingData }
              };
              hasProposal = true;
            } else if (parsed.meals || (parsed.dietPlan && parsed.dietPlan.meals)) {
              // Looks like a DietPlan
              const dietData = parsed.meals ? parsed : (parsed.dietPlan || parsed);
              cleanResponse = {
                ...cleanResponse,
                text: cleanText.replace(jsonMatch[0], '').replace(/```json/gi, '').replace(/```/g, '').trim(),
                proposal: { type: 'diet', data: dietData }
              };
              hasProposal = true;
            }
          }
        } catch (e) {
          // Ignore parse errors, fallback to generating it
        }
      }

      if (isTrainingProposal && !hasProposal) {
        try {
          const proposal = await generateProposal('training', cleanText, userContext?.profile, userContext?.profile?.uid, forceFallback);
          cleanResponse = {
            ...cleanResponse,
            proposal: { type: 'training', data: proposal }
          };
          hasProposal = true;
        } catch (err: any) {
          console.error("Erro na proposta de treino:", err);
          if (err.code === 'PRIMARY_ENGINE_OFFLINE') {
            setPendingFallback({ message: messageToSend, context: cleanText, type: 'training' });
          }
        }
      }

      if (isDietProposal && !hasProposal) {
        try {
           const proposal = await generateProposal('diet', cleanText, userContext?.profile, userContext?.profile?.uid, forceFallback);
           cleanResponse = {
             ...cleanResponse,
             proposal: { type: 'diet', data: proposal }
           };
        } catch (err: any) {
          console.error("Erro na proposta de dieta:", err);
          if (err.code === 'PRIMARY_ENGINE_OFFLINE') {
            setPendingFallback({ message: messageToSend, context: cleanText, type: 'diet' });
          }
        }
      }
      
      setHistory(prev => {
        const withoutOldResp = prev.slice(0, -1); 
        return [...withoutOldResp, cleanResponse];
      });

      // Update online status on successful communication
      setNeuralLinkOnline(true);

    } catch (error: any) {
      console.error(error);
      const technicalError = error?.message || String(error);
      const errorData = error?.rawResponse || error;
      
      if (error.code === 'PRIMARY_ENGINE_OFFLINE' || error.message.includes('Failed to fetch') || !navigator.onLine) {
        setNeuralLinkOnline(false);
        setPendingFallback({ message: messageToSend, type: 'chat' });
        setHistory(prev => [...prev, { 
          role: 'model', 
          text: `⚠️ **MOTOR PRIMÁRIO OFFLINE**\n\nO Motor de Elite IronMind não respondeu.\n\n**Mensagem:** ${technicalError}\n\n**Deseja acionar o Motor de Segurança (Gemini) para processar esta mensagem?**` 
        }]);
      } else {
        const technicalDetails = error?.technicalDetails || {};
        const detailString = JSON.stringify({
          message: error.message,
          status: technicalDetails.status || error.status,
          body: technicalDetails.body || error.body,
          raw: error.rawResponse || error
        }, null, 2);

        setHistory(prev => [...prev, { 
          role: 'model', 
          text: `⚠️ **BLOQUEIO NEURAL (ERRO COMPLETO)**\n\n**Mensagem de Erro:** ${technicalError}\n\n**Destaque Técnico (Payload de Erro):**\n\`\`\`json\n${detailString}\n\`\`\`\n\n> Verifique suas credenciais nos Settings do projeto ou o status do Cérebro Externo configurado no Diagnóstico.` 
        }]);
      }
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="flex flex-col h-full bg-slate-50 dark:bg-[#0a0a0a]">
      {/* Header com Status do Gerente de IA */}
      <div className="bg-white/50 backdrop-blur-sm dark:bg-[#121212]/50 border-b border-slate-200/50 dark:border-slate-800/50 p-2 flex justify-between items-center sticky top-0 z-20 px-4 flex-shrink-0">
        <div className="flex items-center gap-3">
            <button 
              onClick={() => setShowDiagnostic(!showDiagnostic)}
              className="flex items-center gap-2 group outline-none"
            >
              <div className="relative flex items-center justify-center w-3 h-3">
                <div className={`absolute inset-0 rounded-full blur-[4px] ${neuralLinkOnline === true ? 'bg-emerald-400 animate-pulse opacity-100' : 'bg-rose-400 opacity-50'}`} />
                <div className={`relative w-2 h-2 rounded-full z-10 ${neuralLinkOnline === true ? 'bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.9)] scale-110' : 'bg-rose-500'}`} />
                {neuralLinkOnline === true && (
                  <div className="absolute inset-0 rounded-full animate-ping bg-emerald-500 opacity-30" />
                )}
              </div>
              <div className="flex flex-col items-start text-left">
                  <span className="text-[7px] font-black uppercase tracking-[0.2em] text-slate-400 group-hover:text-blue-500 transition-colors">Neural Link</span>
                  <span className="text-[9px] font-bold text-slate-600 dark:text-slate-300">
                    {neuralLinkOnline === true ? 'Link Ativo' : neuralLinkOnline === false ? 'Link Offline' : 'Verificando...'}
                  </span>
              </div>
            </button>
        </div>

        <div className="flex items-center gap-2">
          <button 
            onClick={onClearChat}
            className="p-2 rounded-xl text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition-all active:scale-95"
            title="Limpar Histórico"
          >
            <Trash2 className="w-4 h-4" />
          </button>
        </div>
      </div>

      <AnimatePresence>
        {showDiagnostic && (
          <NeuralLinkDiagnostic 
            onClose={() => setShowDiagnostic(false)} 
            onStatusChange={(online) => setNeuralLinkOnline(online)}
          />
        )}
        {showQuotaInfo && (
          <motion.div 
            initial={{ height: 0, opacity: 0 }}
            animate={{ height: 'auto', opacity: 1 }}
            exit={{ height: 0, opacity: 0 }}
            className="bg-blue-600 text-white overflow-hidden"
          >
             <div className="p-4 border-b border-white/10">
                <div className="flex items-center gap-3 mb-2">
                   <Cpu className="w-5 h-5 opacity-50" />
                   <h4 className="text-[10px] font-black uppercase tracking-[0.2em] italic">Status da Cota Gemini</h4>
                </div>
                <p className="text-[10px] opacity-90 leading-relaxed font-bold uppercase tracking-tight">
                  Este app utiliza o <strong className="text-white">IronMind Neural Engine</strong> com roteamento inteligente entre modelos Gemini (1.5, 2.0, Pro). O plano gratuito oferece alta disponibilidade através de fallback automático.
                </p>
                <button 
                  onClick={() => setShowQuotaInfo(false)}
                  className="mt-3 text-[9px] font-black uppercase tracking-widest bg-white/20 px-3 py-1 rounded-lg hover:bg-white/30 transition-all"
                >
                  Entendido
                </button>
             </div>
          </motion.div>
        )}
      </AnimatePresence>

      <div ref={scrollRef} className="flex-1 overflow-y-auto p-4 space-y-4 touch-pan-y">
        {history.map((msg, i) => (
          <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`max-w-[85%] rounded-2xl p-4 ${
              msg.role === 'user' 
                ? 'bg-blue-600 text-white rounded-tr-md' 
                : 'bg-white dark:bg-[#181818] text-slate-700 dark:text-slate-300 rounded-tl-md border border-slate-200/50 dark:border-slate-800/50'
            }`}>
              <div className={`text-sm leading-relaxed font-medium markdown-body select-text ${msg.role === 'user' ? 'text-white' : 'text-slate-700 dark:text-slate-300'}`}>
                <ReactMarkdown 
                  remarkPlugins={[remarkGfm]}
                  components={{
                    table: ({ children }) => (
                      <div className="my-4 overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm">
                        <table className="w-full text-xs text-left border-collapse bg-white dark:bg-slate-900">
                          {children}
                        </table>
                      </div>
                    ),
                    thead: ({ children }) => <thead className="bg-slate-50 dark:bg-slate-800/50 text-slate-800 dark:text-white uppercase font-black text-[10px] tracking-tight">{children}</thead>,
                    th: ({ children }) => <th className="px-3 py-2 border-b border-slate-200 dark:border-slate-800">{children}</th>,
                    td: ({ children }) => <td className="px-3 py-2 border-b border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-400">{children}</td>,
                    strong: ({ children }) => <span className="font-bold text-blue-600 dark:text-blue-400">{children}</span>,
                    hr: () => <hr className="my-6 border-slate-200 dark:border-slate-800" />,
                  }}
                >
                  {msg.text}
                </ReactMarkdown>
              </div>
              
              {msg.role !== 'user' && (
                <button 
                  onClick={() => {
                    navigator.clipboard.writeText(msg.text);
                    setCopiedIndex(i);
                    setTimeout(() => setCopiedIndex(null), 2000);
                  }}
                  className="mt-2 flex items-center gap-1.5 text-[10px] text-slate-400 font-medium hover:text-slate-600 dark:hover:text-slate-300 transition-colors cursor-pointer"
                >
                  {copiedIndex === i ? (
                    <><Check className="w-3 h-3 text-emerald-500" /> <span className="text-emerald-500 font-bold uppercase tracking-wider">Copiado!</span></>
                  ) : (
                    <><Copy className="w-3 h-3" /> <span className="uppercase tracking-wider font-bold">Copiar Texto</span></>
                  )}
                </button>
              )}

              {msg.shouldClearHistory && onClearChat && (
                <button 
                  onClick={onClearChat}
                  className="mt-3 w-full py-2 bg-rose-600 text-white rounded-xl text-[9px] font-black uppercase tracking-widest flex items-center justify-center gap-2 shadow-lg shadow-rose-100"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  Zerar Chat Agora
                </button>
              )}
              
              {msg.proposal && (
                <div className={`mt-4 p-4 rounded-xl border ${
                  msg.role === 'user' 
                    ? 'bg-white/10 border-white/20 text-white' 
                    : 'bg-slate-50 dark:bg-[#121212] border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200'
                }`}>
                  <p className="text-[8px] font-[1000] uppercase tracking-widest mb-1 opacity-80">
                    Proposta de {msg.proposal.type === 'training' ? 'Treino' : 'Dieta'}
                  </p>
                  <p className="text-sm font-bold mb-3">{msg.proposal.data.name}</p>
                  
                  {/* Spreadsheet View */}
                  <div className="mb-4 overflow-x-auto rounded-lg border border-blue-200 dark:border-blue-800 bg-white dark:bg-slate-900 shadow-inner">
                    <table className="w-full text-[10px] text-left border-collapse">
                      <thead className="bg-blue-600 text-white uppercase font-black tracking-tighter">
                        <tr>
                          {msg.proposal.type === 'training' ? (
                            <>
                              <th className="px-2 py-1.5 border-b border-blue-500">Exercício</th>
                              <th className="px-2 py-1.5 border-b border-blue-500 text-center">Séries</th>
                              <th className="px-2 py-1.5 border-b border-blue-500 text-center">Reps</th>
                              <th className="px-2 py-1.5 border-b border-blue-500 text-center">Desc</th>
                            </>
                          ) : (
                            <>
                              <th className="px-2 py-1.5 border-b border-blue-500">Hora</th>
                              <th className="px-2 py-1.5 border-b border-blue-500">Refeição</th>
                              <th className="px-2 py-1.5 border-b border-blue-500">Itens</th>
                            </>
                          )}
                        </tr>
                      </thead>
                      <tbody>
                        {msg.proposal.type === 'training' ? (
                          (msg.proposal.data as TrainingPlan).days?.flatMap(day => 
                            day.exercises.map((ex, exIdx) => (
                              <tr key={`${day.label}-${exIdx}`} className="border-b border-slate-100 dark:border-slate-800 hover:bg-blue-50 dark:hover:bg-blue-900/10">
                                <td className="px-2 py-1.5 font-bold text-slate-800 dark:text-slate-200 truncate max-w-[100px]">{ex.name}</td>
                                <td className="px-2 py-1.5 text-center text-slate-600 dark:text-slate-400">{ex.sets}</td>
                                <td className="px-2 py-1.5 text-center text-slate-600 dark:text-slate-400">{ex.reps}</td>
                                <td className="px-2 py-1.5 text-center text-slate-600 dark:text-slate-400">{ex.rest || '-'}</td>
                              </tr>
                            ))
                          )
                        ) : (
                          (msg.proposal.data as DietPlan).meals?.map((meal, mIdx) => (
                            <tr key={mIdx} className="border-b border-slate-100 dark:border-slate-800 hover:bg-blue-50 dark:hover:bg-blue-900/10">
                              <td className="px-2 py-1.5 font-black text-blue-600 dark:text-blue-400">{meal.time}</td>
                              <td className="px-2 py-1.5 font-bold text-slate-800 dark:text-slate-200">{meal.name}</td>
                              <td className="px-2 py-1.5 text-slate-500 dark:text-slate-500 italic truncate max-w-[120px]">{meal.items.join(', ')}</td>
                            </tr>
                          ))
                        )}
                      </tbody>
                    </table>
                  </div>

                  <div className="flex gap-2">
                    <button 
                      onClick={() => {
                        let planData = msg.proposal?.data;
                        
                        // Extração Robusta de JSON (IronMind Neural Engine - V12)
                        if (planData?.text && typeof planData.text === 'string') {
                          try {
                            const rawText = planData.text;
                            // Prioridade 1: Conteúdo entre blocos ```json ... ```
                            // Prioridade 2: Conteúdo entre o primeiro { e o último }
                            const jsonBlockMatch = rawText.match(/```json\s+([\s\S]*?)\s+```/) || 
                                                 rawText.match(/```\s+([\s\S]*?)\s+```/) ||
                                                 rawText.match(/(\{[\s\S]*\})/);
                            
                            const jsonCandidate = jsonBlockMatch ? (jsonBlockMatch[1] || jsonBlockMatch[0]) : null;
                            
                            if (jsonCandidate) {
                              const parsed = JSON.parse(jsonCandidate.trim());
                              if (parsed) planData = parsed;
                            }
                          } catch (e) {
                            console.error("[JSON_PATCH] Falha no parse via Frontend:", e);
                          }
                        }

                        if (msg.proposal?.type === 'training') {
                          // Fuzzy Mapping for Days
                          let rawDays = planData?.days || planData?.dias || planData?.treinos || planData?.protocolo;
                          if ((!Array.isArray(rawDays) || rawDays.length === 0) && planData && typeof planData === 'object') {
                            rawDays = Object.values(planData).find(v => Array.isArray(v) && v.length > 0) as any[];
                          }

                          const trainingPlan: TrainingPlan = {
                            id: planData?.id || (typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 11)),
                            name: planData?.name || planData?.nome || "Novo Treino",
                            description: planData?.description || planData?.descricao || "",
                            days: Array.isArray(rawDays) ? rawDays.map((day: any) => {
                              // Fuzzy Mapping for Exercises
                              let rawExercises = day.exercises || day.exercicios || day.atividades || day.rotina;
                              if ((!Array.isArray(rawExercises) || rawExercises.length === 0) && day && typeof day === 'object') {
                                rawExercises = Object.values(day).find(v => Array.isArray(v) && v.length > 0) as any[];
                              }

                              return {
                                label: day.label || day.nome || day.titulo || "Treino",
                                exercises: Array.isArray(rawExercises) ? rawExercises.map((ex: any) => ({
                                  id: ex.id || (typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 11)),
                                  name: ex.name || ex.nome || "Exercício",
                                  sets: Number(ex.sets || ex.series) || 3,
                                  reps: String(ex.reps || ex.repeticoes || "12"),
                                  weight: ex.weight || ex.peso || "",
                                  rest: String(ex.rest || ex.descanso || "60"),
                                  videoUrl: ex.videoUrl || ex.video || "",
                                  notes: ex.notes || ex.observacoes || ex.notas || ""
                                })) : []
                              };
                            }) : [],
                            createdAt: planData?.createdAt || Date.now()
                          };
                          localStorage.setItem('ironmind_training', JSON.stringify(trainingPlan));
                          onAcceptTraining(trainingPlan);
                        } else if (msg.proposal?.type === 'diet') {
                          // Fuzzy Mapping for Meals
                          let rawMeals = planData?.meals || planData?.refeicoes || planData?.dieta || planData?.cardapio;
                          if ((!Array.isArray(rawMeals) || rawMeals.length === 0) && planData && typeof planData === 'object') {
                            rawMeals = Object.values(planData).find(v => Array.isArray(v) && v.length > 0) as any[];
                          }

                          const dietPlan: DietPlan = {
                            id: planData?.id || (typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 11)),
                            name: planData?.name || planData?.nome || "Nova Dieta",
                            description: planData?.description || planData?.descricao || "",
                            meals: Array.isArray(rawMeals) ? rawMeals.map((meal: any) => {
                              // Fuzzy Mapping for Items
                              let rawItems = meal.items || meal.itens || meal.alimentos || meal.ingredientes;
                              if ((!Array.isArray(rawItems) || rawItems.length === 0) && meal && typeof meal === 'object') {
                                rawItems = Object.values(meal).find(v => Array.isArray(v) && v.length > 0) as any[];
                              }

                              return {
                                name: meal.name || meal.nome || "Refeição",
                                time: meal.time || meal.horario || meal.hora || "00:00",
                                items: Array.isArray(rawItems) ? rawItems.map((item: any) => typeof item === 'object' ? (item.name || item.nome || JSON.stringify(item)) : String(item)) : []
                              };
                            }) : [],
                            createdAt: planData?.createdAt || Date.now()
                          };
                          localStorage.setItem('ironmind_diet', JSON.stringify(dietPlan));
                          onAcceptDiet(dietPlan);
                        }
                        
                        // Dismiss proposal after accepting to avoid double clicks with immutable state mapping
                        const newHistory = history.map((m, idx) => {
                          if (idx === i) {
                            const { proposal, ...cleanMsg } = m;
                            return cleanMsg;
                          }
                          return m;
                        });
                        setHistory(newHistory);
                      }}
                      className={`flex-1 py-2.5 rounded-lg flex items-center justify-center gap-2 font-black text-[9px] uppercase tracking-widest transition-all ${
                        msg.role === 'user'
                          ? 'bg-white text-blue-600'
                          : 'bg-emerald-600 text-white shadow-lg active:scale-95'
                      }`}
                    >
                      <Check className="w-3.5 h-3.5" /> Aceitar {msg.proposal.type === 'training' ? 'Treino' : 'Dieta'}
                    </button>
                    
                    <button 
                      onClick={() => {
                        // Mark proposal as dismissed by removing it from the message locally with immutable state mapping
                        const newHistory = history.map((m, idx) => {
                          if (idx === i) {
                            const { proposal, ...cleanMsg } = m;
                            return cleanMsg;
                          }
                          return m;
                        });
                        setHistory(newHistory);
                      }}
                      className={`px-4 py-2.5 rounded-lg flex items-center justify-center gap-2 font-black text-[9px] uppercase tracking-widest transition-all border ${
                        msg.role === 'user'
                          ? 'border-white/40 text-white hover:bg-white/10'
                          : 'border-slate-200 dark:border-slate-700 text-rose-500 hover:bg-rose-50'
                      }`}
                    >
                      <X className="w-3.5 h-3.5" /> Recusar
                    </button>
                  </div>
                  
                  <button 
                    onClick={() => {
                      setInput(msg.proposal?.type === 'training' ? "Gostei, mas quero refinar este treino. Pode mudar alguns exercícios?" : "Quero refinar esta dieta. Pode ajustar os alimentos?");
                    }}
                    className="w-full mt-2 py-1.5 text-[8px] font-black uppercase tracking-widest text-slate-400 hover:text-blue-500 transition-colors"
                  >
                    Ou clique aqui para Refinar
                  </button>
                </div>
              )}
            </div>
          </div>
        ))}

        {pendingFallback && (
          <motion.div 
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
            className="flex flex-col items-center gap-3 p-6 bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-800 rounded-2xl"
          >
            <div className="flex items-center gap-2 text-blue-600 dark:text-blue-400">
              <ShieldAlert className="w-5 h-5" />
              <span className="text-[10px] font-black uppercase tracking-[0.2em]">Acionamento Especial</span>
            </div>
            <p className="text-[11px] text-center text-slate-600 dark:text-slate-400 font-bold max-w-xs leading-relaxed">
              O Motor de Elite IronMind está em manutenção. Deseja acionar o Motor de Segurança (Gemini)?
            </p>
            <div className="flex gap-2 w-full max-w-[280px]">
              <button 
                onClick={() => handleSend(pendingFallback.message, true)}
                className="flex-1 bg-blue-600 text-white py-3 rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 shadow-lg shadow-blue-200/50 active:scale-95 transition-all"
              >
                <ShieldCheck className="w-4 h-4" /> Sim, Ativar Gemini
              </button>
              <button 
                onClick={() => setPendingFallback(null)}
                className="px-6 bg-white dark:bg-slate-900 text-slate-400 border border-slate-200 dark:border-slate-800 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest active:scale-95 transition-all"
              >
                Ignorar
              </button>
            </div>
          </motion.div>
        )}

        {isLoading && (
          <div className="flex justify-start">
            <div className="bg-white dark:bg-[#181818] rounded-xl rounded-tl-none p-3 flex flex-col gap-2 border border-slate-200 dark:border-slate-800 shadow-sm min-w-[200px]">
              <div className="flex items-center gap-2">
                <Loader2 className="w-3.5 h-3.5 animate-spin text-blue-600" />
                <span className="text-[9px] font-black text-slate-400 uppercase tracking-widest">{loadingMessage}</span>
              </div>
              {loadingMessage.includes('Tentativa') && (
                <div className="w-full bg-slate-100 dark:bg-slate-800 h-1 rounded-full overflow-hidden">
                   <motion.div 
                     initial={{ width: "0%" }}
                     animate={{ width: "100%" }}
                     transition={{ duration: 10, ease: "linear", repeat: Infinity }}
                     className="bg-blue-500 h-full"
                   />
                </div>
              )}
            </div>
          </div>
        )}
      </div>

      <div 
        className="p-3 bg-white dark:bg-[#121212] border-t border-slate-200 dark:border-slate-800 flex-shrink-0"
        onPointerDown={(e) => e.stopPropagation()}
        onMouseDown={(e) => e.stopPropagation()}
        onTouchStart={(e) => e.stopPropagation()}
      >
        <form 
          onSubmit={(e) => {
            e.preventDefault();
            handleSend();
          }}
          className="flex gap-2 items-end"
        >
          <textarea 
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onPointerDown={(e) => e.stopPropagation()}
            onMouseDown={(e) => e.stopPropagation()}
            onTouchStart={(e) => e.stopPropagation()}
            placeholder="Falar com o Treinador..."
            rows={1}
            className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-300 transition-all text-slate-700 min-h-[48px] max-h-32 resize-none"
          />
          <button 
            type="submit"
            disabled={isLoading}
            onPointerDown={(e) => e.stopPropagation()}
            onMouseDown={(e) => e.stopPropagation()}
            onTouchStart={(e) => e.stopPropagation()}
            className="w-12 h-12 bg-blue-600 text-white rounded-xl flex-none flex items-center justify-center hover:bg-blue-700 disabled:opacity-50 transition-all shadow-md active:scale-95"
          >
            <Send className="w-5 h-5 flex-none" />
          </button>
        </form>
      </div>
    </div>
  );
}
