import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { Dumbbell, Utensils, Zap, User, TrendingUp, Sparkles, Scale, Info, ChevronLeft, Calendar } from 'lucide-react';
import { db, auth as firebaseAuth } from './lib/firebase';
import { doc, getDoc, setDoc, updateDoc, collection, query, orderBy, limit, getDocs, onSnapshot } from 'firebase/firestore';

import Login from './components/Login';
import Register from './components/Register';
import TrainingTab from './components/TrainingTab';
import DietTab from './components/DietTab';
import TreinadorTab from './components/TreinadorTab';
import ProfileTab from './components/ProfileTab';
import HistoryTab from './components/HistoryTab';
import AqueceTab from './components/AqueceTab';

import { useAuth } from './components/AuthProvider';
import { ChatMessage, TrainingPlan, DietPlan, WeightEntry, MeasurementEntry, LoadEntry, Tab } from './types';

export default function App() {
  const { user, profile, setProfile, loading } = useAuth();
  const [activeTab, setActiveTab] = useState<Tab>(Tab.TREINADOR);
  const [showSplash, setShowSplash] = useState(true);
  const [showRegister, setShowRegister] = useState(false);

  // States for user data
  const [trainingPlan, setTrainingPlan] = useState<TrainingPlan | null>(null);
  const [dietPlan, setDietPlan] = useState<DietPlan | null>(null);
  const [chatHistory, setChatHistory] = useState<ChatMessage[]>([
    { role: 'model', text: 'Saudações. Eu sou o IronMind Neural. Sou o núcleo de inteligência deste ecossistema. Como posso otimizar sua performance hoje? Quer estruturar um novo ciclo de treinamento ou alinhar sua nutrição?' }
  ]);
  const [weightHistory, setWeightHistory] = useState<WeightEntry[]>([]);
  const [measurementHistory, setMeasurementHistory] = useState<MeasurementEntry[]>([]);
  const [loadHistory, setLoadHistory] = useState<LoadEntry[]>([]);

  // Confirmation Modals State
  const [showConfirmClearTraining, setShowConfirmClearTraining] = useState(false);
  const [showConfirmClearDiet, setShowConfirmClearDiet] = useState(false);
  const [showConfirmClearChat, setShowConfirmClearChat] = useState(false);
  const [showConfirmClearHistory, setShowConfirmClearHistory] = useState(false);
  const [showConfirmHardReset, setShowConfirmHardReset] = useState(false);

  // Sync state with firestore when authenticated
  useEffect(() => {
    if (!user) return;

    const userDoc = doc(db, 'users', user.uid);
    
    // Listen to main user document (weightHistory, measurementHistory, loadHistory, plans)
    const unsubUser = onSnapshot(userDoc, 
      (docSnap) => {
        if (docSnap.exists()) {
          const data = docSnap.data();
          if (data.weightHistory) setWeightHistory(data.weightHistory);
          if (data.measurementHistory) setMeasurementHistory(data.measurementHistory);
          if (data.loadHistory) setLoadHistory(data.loadHistory);
          if (data.trainingPlan) setTrainingPlan(data.trainingPlan);
          if (data.dietPlan) setDietPlan(data.dietPlan);
        }
      },
      (err) => {
        console.warn("Real-time profile listener suspended/disconnected:", err);
      }
    );

    // Listen to chat history
    const chatQuery = query(collection(userDoc, 'chats'), orderBy('timestamp', 'asc'), limit(50));
    const unsubChat = onSnapshot(chatQuery, 
      (snap) => {
        const msgs = snap.docs.map(d => ({
          role: d.data().role,
          text: d.data().text,
          proposal: d.data().proposal
        } as ChatMessage));
        if (msgs.length > 0) setChatHistory(msgs);
      },
      (err) => {
        console.warn("Real-time chats listener suspended/disconnected:", err);
      }
    );

    return () => {
      unsubUser();
      unsubChat();
    };
  }, [user]);

  // Sync biometrics to Firestore
  useEffect(() => {
    if (!user || weightHistory.length === 0) return;
    updateDoc(doc(db, 'users', user.uid), { weightHistory })
      .catch(err => console.warn("Failsafe: error syncing weight history:", err));
  }, [weightHistory, user]);

  useEffect(() => {
    if (!user || measurementHistory.length === 0) return;
    updateDoc(doc(db, 'users', user.uid), { measurementHistory })
      .catch(err => console.warn("Failsafe: error syncing measurement history:", err));
  }, [measurementHistory, user]);

  useEffect(() => {
    if (!user || loadHistory.length === 0) return;
    updateDoc(doc(db, 'users', user.uid), { loadHistory })
      .catch(err => console.warn("Failsafe: error syncing load history:", err));
  }, [loadHistory, user]);

  // Plan actions
  const saveTraining = async (plan: TrainingPlan) => {
    setTrainingPlan(plan);
    setActiveTab(Tab.TREINO);
    if (user) {
      await updateDoc(doc(db, 'users', user.uid), { trainingPlan: plan })
        .catch(err => console.warn("Failsafe: error syncing training plan:", err));
    }
  };

  const saveDiet = async (plan: DietPlan) => {
    setDietPlan(plan);
    setActiveTab(Tab.DIETA);
    if (user) {
      await updateDoc(doc(db, 'users', user.uid), { dietPlan: plan })
        .catch(err => console.warn("Failsafe: error syncing diet plan:", err));
    }
  };

  const clearTrainingPlan = async () => {
    setTrainingPlan(null);
    if (user) {
      await updateDoc(doc(db, 'users', user.uid), { trainingPlan: null })
        .catch(err => console.warn("Failsafe: error syncing training plan clear:", err));
    }
    setShowConfirmClearTraining(false);
  };

  const clearDietPlan = async () => {
    setDietPlan(null);
    if (user) {
      await updateDoc(doc(db, 'users', user.uid), { dietPlan: null })
        .catch(err => console.warn("Failsafe: error syncing diet plan clear:", err));
    }
    setShowConfirmClearDiet(false);
  };

  const clearChatHistory = async () => {
    const initialMessage: ChatMessage = { role: 'model', text: 'Olá! Sou o IronMind, seu treinador pessoal. Como posso te ajudar hoje? Quer montar um treino novo ou uma dieta?' };
    setChatHistory([initialMessage]);
    
    if (user) {
      // Clear chats subcollection (batch would be better)
      const chatCol = collection(db, 'users', user.uid, 'chats');
      const snap = await getDocs(chatCol);
      // For simplicity, we just set a reset flag or let user handle it.  
      // Deleting subcollections is complex from client. 
      // We'll just reset the local state and inform the user.
    }
    setShowConfirmClearChat(false);
  };

  const clearHistory = async () => {
    setWeightHistory([]);
    setMeasurementHistory([]);
    setLoadHistory([]);
    if (user) {
      await updateDoc(doc(db, 'users', user.uid), { 
        weightHistory: [], 
        measurementHistory: [], 
        loadHistory: [] 
      });
    }
    setShowConfirmClearHistory(false);
  };

  const hardReset = async () => {
    setTrainingPlan(null);
    setDietPlan(null);
    const initialMessage: ChatMessage = { role: 'model', text: 'Olá! Sou o IronMind, seu treinador pessoal. Como posso te ajudar hoje? Quer montar um treino novo ou uma dieta?' };
    setChatHistory([initialMessage]);
    setWeightHistory([]);
    setMeasurementHistory([]);
    setLoadHistory([]);
    
    if (user) {
      // Para o MVP de reset, limpar o doc principal já remove Treinos/Dietas/Histórico persistidos no doc.
      await updateDoc(doc(db, 'users', user.uid), {
        trainingPlan: null,
        dietPlan: null,
        weightHistory: [],
        measurementHistory: [],
        loadHistory: []
      });
    }
    setShowConfirmHardReset(false);
  };

  // Auth Guard
  if (loading) return null;
  if (!user) {
    if (showRegister) return <Register onBack={() => setShowRegister(false)} />;
    return <Login onRegister={() => setShowRegister(true)} />;
  }
  if (!profile) return <Register onBack={() => firebaseAuth.signOut()} />; // Should not happen if registered correctly

  if (showSplash) {
    return <SplashScreen onComplete={() => setShowSplash(false)} />;
  }

  return (
    <div className="flex justify-center bg-slate-950 min-h-screen text-slate-100 selection:bg-blue-600 selection:text-white">
      {/* Container Principal Simulado como App Mobile com design estendido para tela inteira se desejado */}
      <div className="w-full max-w-md bg-slate-950 min-h-screen flex flex-col relative shadow-[0_0_50px_rgba(0,0,0,0.8)] border-x border-slate-905" id="applet-container">
        
        {/* CABEÇALHO DO APLICATIVO */}
        <header className="bg-slate-950 border-b border-slate-900 px-6 py-4 flex items-center justify-between sticky top-0 z-30">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 bg-gradient-to-br from-slate-200 via-slate-300 to-slate-500 border border-white/20 flex items-center justify-center shadow-lg relative rounded-[1px]">
               <div className="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/concrete-wall.png')] opacity-20 pointer-events-none"></div>
               <Dumbbell className="w-4 h-4 text-slate-950 transform -rotate-12" />
            </div>
            <div className="flex flex-col leading-none">
              <span className="font-[1000] text-lg uppercase tracking-tight flex items-center italic">
                 <span className="text-slate-100">Iron</span>
                 <span className="text-blue-500 font-black">Mind</span>
              </span>
              <span className="text-[7px] font-black uppercase tracking-[0.45em] text-slate-500 mt-0.5">Core v2.6.2</span>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <div className="flex items-center gap-1.5 px-2.5 py-1 bg-slate-900 border border-slate-800 rounded-full">
              <span className="relative flex h-1.5 w-1.5">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span className="relative inline-flex rounded-full h-1.5 w-1.5 bg-blue-500"></span>
              </span>
              <span className="text-[8px] font-black uppercase tracking-wider text-slate-400">Premium</span>
            </div>
          </div>
        </header>

        {/* CONTEÚDO DA TELA DA ABA ATIVA */}
        <main className="flex-1 overflow-y-auto mb-20">
          <AnimatePresence mode="wait">
            <motion.div
              key={activeTab}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -10 }}
              transition={{ duration: 0.2 }}
              className="h-full"
            >
              {activeTab === Tab.TREINADOR && (
                <TreinadorTab 
                  history={chatHistory} 
                  setHistory={setChatHistory} 
                  onAcceptTraining={saveTraining}
                  onAcceptDiet={saveDiet}
                  onClearChat={() => setShowConfirmClearChat(true)}
                  userContext={{
                    profile: profile,
                    weight: weightHistory.length > 0 ? weightHistory[weightHistory.length - 1].weight : null,
                    measurements: measurementHistory
                  }}
                />
              )}

              {activeTab === Tab.AQUECE && (
                <AqueceTab />
              )}

              {activeTab === Tab.TREINO && (
                trainingPlan ? (
                  <TrainingPlanLayout plan={trainingPlan} onClear={() => setShowConfirmClearTraining(true)} />
                ) : (
                  <EmptyState type="treino" onClick={() => setActiveTab(Tab.TREINADOR)} onManualBuild={() => {
                    // Manual creation of mock training for users who want immediate plan without AI first
                    const manualPlan: TrainingPlan = {
                      title: "Protocolo Híbrido de Adaptação",
                      goals: "Hipertrofia e Resistência Geral",
                      split: [
                        {
                          day: "Treino A: Push (Peito, Ombros, Tríceps)",
                          exercises: [
                            { name: "Supino Reto com Halteres", sets: 4, reps: "10-12", weight: "24kg/cada", videoUrl: "https://www.youtube.com/embed/v9S5S7vEylM", notes: "Controle a descida em 3 segundos." },
                            { name: "Desenvolvimento de Ombros", sets: 3, reps: "10", weight: "16kg/cada", videoUrl: "https://www.youtube.com/embed/XmXzIofG7b4", notes: "Foco na contração máxima de ombros." },
                            { name: "Tríceps Pulley", sets: 3, reps: "12-15", weight: "40kg", videoUrl: "https://www.youtube.com/embed/8b96AmswO40", notes: "Extensão total do cotovelo sem abrir." }
                          ]
                        },
                        {
                          day: "Treino B: Pull (Costas, Bíceps, Antebraço)",
                          exercises: [
                            { name: "Puxada Aberta na Frente", sets: 4, reps: "12", weight: "50kg", videoUrl: "https://www.youtube.com/embed/fD33Cun_Wgw", notes: "Esqueça os braços, puxe com as costas." },
                            { name: "Remada Curvada com Halteres", sets: 3, reps: "10", weight: "20kg/cada", videoUrl: "https://www.youtube.com/embed/CAsq9U_89uA", notes: "Mantenha o abdômen contraído." },
                            { name: "Rosca Direta Clássica", sets: 3, reps: "12", weight: "12kg/cada", videoUrl: "https://www.youtube.com/embed/Q6Y3d5rWeYc", notes: "Sem roubar com as costas." }
                          ]
                        }
                      ]
                    };
                    saveTraining(manualPlan);
                  }} />
                )
              )}

              {activeTab === Tab.DIETA && (
                dietPlan ? (
                  <DietPlanLayout plan={dietPlan} onClear={() => setShowConfirmClearDiet(true)} />
                ) : (
                  <EmptyState type="dieta" onClick={() => setActiveTab(Tab.TREINADOR)} />
                )
              )}

              {activeTab === Tab.HISTORICO && (
                <HistoryTab 
                  weightHistory={weightHistory}
                  setWeightHistory={setWeightHistory}
                  measurementHistory={measurementHistory}
                  setMeasurementHistory={setMeasurementHistory}
                  loadHistory={loadHistory}
                  setLoadHistory={setLoadHistory}
                  userProfile={profile}
                  setUserProfile={setProfile}
                  onClearHistory={() => setShowConfirmClearHistory(true)}
                  onClearChat={() => setShowConfirmClearChat(true)}
                  onClearTraining={() => setShowConfirmClearTraining(true)}
                  onClearDiet={() => setShowConfirmClearDiet(true)}
                  onHardReset={() => setShowConfirmHardReset(true)}
                />
              )}

              {activeTab === Tab.PERFIL && (
                <ProfileTab profile={profile} setProfile={setProfile} />
              )}
            </motion.div>
          </AnimatePresence>
        </main>

        {/* BARRA DE NAVEGAÇÃO INFERIOR */}
        <nav className="bg-slate-950 border-t border-slate-900 absolute bottom-0 inset-x-0 h-20 flex items-center justify-around px-2 z-30">
          <TabButton active={activeTab === Tab.TREINADOR} onClick={() => setActiveTab(Tab.TREINADOR)} icon={<Zap className="w-5 h-5" />} label="Treinador" />
          <TabButton active={activeTab === Tab.AQUECE} onClick={() => setActiveTab(Tab.AQUECE)} icon={<Sparkles className="w-5 h-5" />} label="Aquece." />
          <TabButton active={activeTab === Tab.TREINO} onClick={() => setActiveTab(Tab.TREINO)} icon={<Dumbbell className="w-5 h-5" />} label="Treino" />
          <TabButton active={activeTab === Tab.DIETA} onClick={() => setActiveTab(Tab.DIETA)} icon={<Utensils className="w-5 h-5" />} label="Dieta" />
          <TabButton active={activeTab === Tab.HISTORICO} onClick={() => setActiveTab(Tab.HISTORICO)} icon={<TrendingUp className="w-5 h-5" />} label="Histórico" />
          <TabButton active={activeTab === Tab.PERFIL} onClick={() => setActiveTab(Tab.PERFIL)} icon={<User className="w-5 h-5" />} label="Perfil" />
        </nav>

        {/* MODAIS DE CONFIRMAÇÃO DE FAILSFE & RESET */}
        <AnimatePresence>
          {(showConfirmClearTraining || showConfirmClearDiet || showConfirmClearChat || showConfirmClearHistory || showConfirmHardReset) && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-6 bg-slate-950/80 backdrop-blur-sm">
              <motion.div 
                initial={{ opacity: 0, scale: 0.95 }}
                animate={{ opacity: 1, scale: 1 }}
                exit={{ opacity: 0, scale: 0.95 }}
                className="bg-slate-900 border border-slate-800 p-6 rounded-3xl w-full max-w-xs text-center space-y-4"
              >
                <div className="w-12 h-12 bg-rose-600/10 border border-rose-500/20 text-rose-500 rounded-2xl flex items-center justify-center mx-auto mb-2">
                  <Info className="w-6 h-6" />
                </div>
                <h3 className="text-sm font-black uppercase tracking-widest text-white leading-none">Confirmar Operação</h3>
                <p className="text-slate-400 text-xs font-bold leading-relaxed uppercase">
                  {showConfirmClearTraining && 'Deseja realmente apagar o seu protocolo de treinamento atual?'}
                  {showConfirmClearDiet && 'Deseja realmente apagar o seu planejamento de dieta atual?'}
                  {showConfirmClearChat && 'Deseja apagar permanentemente todas as suas mensagens do histórico com o treinador?'}
                  {showConfirmClearHistory && 'Deseja realmente zerar todo o seu histórico de peso e medidas corporais?'}
                  {showConfirmHardReset && 'AVISO: Isso irá apagar todo o seu progresso, treinos, dietas e histórico. É um reset de dados completo.'}
                </p>
                <div className="flex gap-3 pt-2">
                  <button 
                    onClick={() => {
                      setShowConfirmClearTraining(false);
                      setShowConfirmClearDiet(false);
                      setShowConfirmClearChat(false);
                      setShowConfirmClearHistory(false);
                      setShowConfirmHardReset(false);
                    }}
                    className="flex-1 py-3 border-2 border-slate-800 hover:bg-slate-800 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors duration-200"
                  >
                    Voltar
                  </button>
                  <button 
                    onClick={() => {
                      if (showConfirmClearTraining) clearTrainingPlan();
                      if (showConfirmClearDiet) clearDietPlan();
                      if (showConfirmClearChat) clearChatHistory();
                      if (showConfirmClearHistory) clearHistory();
                      if (showConfirmHardReset) hardReset();
                    }}
                    className={`flex-1 py-3 ${showConfirmHardReset ? 'bg-red-600' : 'bg-rose-600'} text-white rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-rose-100`}
                  >
                    Confirmar
                  </button>
                </div>
              </motion.div>
            </div>
          )}
        </AnimatePresence>

      </div>
    </div>
  );
}

function TabButton({ active, onClick, icon, label }: { active: boolean, onClick: () => void, icon: React.ReactNode, label: string }) {
  return (
    <button 
      onClick={onClick}
      className={`flex flex-col items-center gap-1.5 py-2.5 px-3 rounded-2xl transition-all duration-300 relative ${
        active 
          ? 'text-blue-500' 
          : 'text-slate-500 hover:text-slate-300'
      }`}
    >
      <div className={`transition-transform duration-300 ${active ? 'scale-110' : ''}`}>
        {icon}
      </div>
      <span className="text-[8px] font-black uppercase tracking-widest leading-none">{label}</span>
      {active && (
        <motion.div 
          layoutId="activeTabIndicator"
          className="absolute bottom-0 inset-x-5 h-[2px] bg-blue-500 rounded-full"
          transition={{ type: "spring", stiffness: 350, damping: 30 }}
        />
      )}
    </button>
  );
}

function TrainingPlanLayout({ plan, onClear }: { plan: TrainingPlan, onClear: () => void }) {
  return (
    <div className="p-4 pb-24 space-y-6 bg-slate-50 text-slate-900 min-h-full">
      <header className="flex justify-between items-center pb-4 border-b border-slate-200">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-md shadow-blue-100">
            <Dumbbell className="w-5 h-5 text-white" />
          </div>
          <div>
            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest leading-none mb-0.5">Treino Atual</p>
            <h2 className="text-xl font-[1000] text-slate-900 tracking-tighter leading-none uppercase italic">{plan.title || 'Seu Protocolo'}</h2>
          </div>
        </div>
        <button 
          onClick={onClear}
          className="p-2 bg-rose-50 border border-rose-100 rounded-xl text-rose-500 hover:bg-rose-100"
        >
          <Trash2 className="w-4 h-4" />
        </button>
      </header>

      {plan.goals && (
        <div className="bg-blue-600 text-white p-4 rounded-3xl space-y-1 shadow-lg shadow-blue-100">
          <span className="text-[8px] font-black uppercase tracking-widest text-blue-100">Fichamento / Foco</span>
          <p className="text-sm font-bold leading-tight">{plan.goals}</p>
        </div>
      )}

      <div className="space-y-6">
        {plan.split.map((dayPlan, dayIdx) => (
          <div key={dayIdx} className="space-y-3">
            <h3 className="text-[10px] font-black uppercase tracking-[0.2em] text-blue-600 border-l-4 border-blue-600 pl-3 leading-none py-1">{dayPlan.day}</h3>
            
            <div className="space-y-4">
              {dayPlan.exercises.map((ex, exIdx) => (
                <div key={exIdx} className="bg-white rounded-3xl border border-slate-200 p-5 space-y-3 shadow-sm hover:border-slate-300 transition-colors">
                  <div className="flex justify-between items-start gap-4">
                    <h4 className="text-xs font-black uppercase leading-tight text-slate-900">{ex.name}</h4>
                    <span className="text-[10px] font-black bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full uppercase shrink-0 leading-none">
                      {ex.sets}x {ex.reps}
                    </span>
                  </div>
                  
                  {ex.weight && (
                    <div className="flex items-center gap-1.5 text-slate-500 text-[10px] font-bold uppercase">
                      <Scale className="w-3.5 h-3.5" />
                      <span>Carga Inicial de Trabalho: {ex.weight}</span>
                    </div>
                  )}

                  {ex.notes && (
                    <div className="flex items-start gap-1.5 text-slate-400 text-[9px] font-bold uppercase leading-relaxed">
                      <Info className="w-3.5 h-3.5 shrink-0 mt-0.5" />
                      <span>{ex.notes}</span>
                    </div>
                  )}
                  
                  {ex.videoUrl && (
                    <div className="relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-100 mt-2 border border-slate-200">
                      <iframe 
                        className="absolute inset-0 w-full h-full"
                        src={ex.videoUrl} 
                        title={ex.name}
                        frameBorder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                        allowFullScreen
                      ></iframe>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function DietPlanLayout({ plan, onClear }: { plan: DietPlan, onClear: () => void }) {
  return (
    <div className="p-4 pb-24 space-y-6 bg-slate-50 text-slate-900 min-h-full">
      <header className="flex justify-between items-center pb-4 border-b border-slate-200">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center shadow-md shadow-blue-100">
            <Utensils className="w-5 h-5 text-white" />
          </div>
          <div>
            <p className="text-[8px] font-black text-slate-400 uppercase tracking-widest leading-none mb-0.5">Planejamento Nutricional</p>
            <h2 className="text-xl font-[1000] text-slate-900 tracking-tighter leading-none uppercase italic">{plan.title || 'Sua Dieta'}</h2>
          </div>
        </div>
        <button 
          onClick={onClear}
          className="p-2 bg-rose-50 border border-rose-100 rounded-xl text-rose-500 hover:bg-rose-100"
        >
          <Trash2 className="w-4 h-4" />
        </button>
      </header>

      {plan.calories && (
        <div className="grid grid-cols-4 gap-2">
          <MacroCard label="Calorias" value={`${plan.calories}kcal`} color="bg-blue-600 text-white" />
          <MacroCard label="Proteínas" value={plan.macros?.protein ? `${plan.macros.protein}g` : '--'} color="bg-white border text-blue-600" />
          <MacroCard label="Carboidratos" value={plan.macros?.carbs ? `${plan.macros.carbs}g` : '--'} color="bg-white border text-slate-705" />
          <MacroCard label="Gorduras" value={plan.macros?.fat ? `${plan.macros.fat}g` : '--'} color="bg-white border text-slate-705" />
        </div>
      )}

      <div className="space-y-5">
        {plan.meals.map((meal, mealIdx) => (
          <div key={mealIdx} className="bg-white rounded-3xl border border-slate-200 p-5 space-y-3 shadow-sm hover:border-slate-300 transition-colors">
            <div className="flex justify-between items-center gap-4 border-b border-slate-100 pb-2.5">
              <h4 className="text-xs font-black uppercase text-slate-900">{meal.name}</h4>
              <span className="text-[9px] font-black text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full uppercase shrink-0 leading-none">
                {meal.time}
              </span>
            </div>
            
            <ul className="space-y-1.5 text-[10px] text-slate-600 font-bold uppercase leading-relaxed list-disc list-inside">
              {meal.foods.map((food, foodIdx) => (
                <li key={foodIdx}>{food}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  );
}

function MacroCard({ label, value, color }: { label: string, value: string, color: string }) {
  return (
    <div className={`${color} p-3 rounded-2xl text-center space-y-0.5 shadow-sm border-slate-200 flex flex-col items-center justify-center`}>
      <span className="text-[7px] font-black uppercase tracking-wider block opacity-70">{label}</span>
      <span className="text-[10px] font-black uppercase tracking-tight leading-none">{value}</span>
    </div>
  );
}

const Trash2 = ({ className }: { className?: string }) => (
  <svg 
    className={className} 
    fill="none" 
    stroke="currentColor" 
    viewBox="0 0 24 24" 
    xmlns="http://www.w3.org/2000/svg"
  >
    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
  </svg>
);
